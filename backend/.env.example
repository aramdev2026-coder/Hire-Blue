# ============================================================
# Blue-Collar Central — Backend Environment Variables
# Copy this file to .env and fill in real values before running
# ============================================================

# Server port
PORT=5000

# Node environment: "development" | "production"
NODE_ENV=development

# JWT secret — MUST be a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=

# 2Factor.in SMS OTP API key
# Get one at: https://2factor.in/
TWO_FACTOR_API_KEY=

# Allowed CORS origins (comma-separated)
# Example: https://admin.hireblue.in,https://portal.hireblue.in
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Bigrock Email SMTP Settings
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreply@aramftc.com
EMAIL_PASS=your_email_password

