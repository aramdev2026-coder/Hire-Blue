datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ADMIN USER SYSTEM (with role hierarchy)
// ==========================================
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUB_ADMIN
}

model Admin {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String    // Hashed secure string
  name      String
  phone     String?
  role      AdminRole @default(ADMIN)
  region    String?   // Optional, for territory-based sub admins
  isActive  Boolean   @default(true)   // Soft-disable instead of deleting
  createdById String?
  createdBy   Admin?    @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAdmins Admin[] @relation("AdminCreatedBy")

  // Back-relations (opposite sides of relations defined on other models)
  candidatesCreated   Candidate[]         @relation("CandidateCreatedBy")
  candidatesAssigned  Candidate[]         @relation("CandidateAssignedTo")
  communicationLogs   CommunicationLog[]
  statusChanges       StatusHistory[]
  assignmentsMade     AssignmentLog[]     @relation("AssignmentLogAssignedBy")
  assignmentsReceived AssignmentLog[]     @relation("AssignmentLogAssignedTo")
  approvedEmployers   Employer[]
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// ==========================================
// 2. CANDIDATE SCHEMA
// ==========================================
enum CandidateStatus {
  NEW
  PENDING_WIZARD
  PENDING_ADMIN_CALL
  CONTACT_ATTEMPTED
  UNREACHABLE
  INTERESTED
  NOT_INTERESTED
  DOCUMENTS_PENDING
  VERIFIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  PLACED
  REJECTED_BY_EMPLOYER
  ON_HOLD
  BLACKLISTED
  INACTIVE
}

enum CandidateSource {
  USER_PORTAL
  SUB_ADMIN
  ADMIN
  SUPER_ADMIN
}

model Candidate {
  // 🔑 Auto-incrementing integer ID starting from 1000
  // The sequence start is set via a raw SQL migration
  id                 Int             @id @default(autoincrement())
  phoneNumber1       String          @unique // Used for 2Factor Login
  phoneNumber2       String?
  fullName           String?
  dob                DateTime?
  sex                String?
  maritalStatus      String?
  familyPhonePrimary String?
  familyPhoneBackup  String?
  emailId            String?
  secondaryEmailId   String?
  presentAddress     String?
  presentDistrict    String?
  presentState       String?
  permanentAddress   String?
  permanentDistrict  String?
  permanentState     String?
  
  // Job Selection Criteria & Background
  jobRoles           String[]        // Array handled natively by Postgres
  preferredDistricts String[]
  expectedSalary     String?
  languagesKnown     String[]        // Added for storing candidate language proficiencies
  
  // 🏢 Shortlisting now links to a real JobRequirement (referential integrity)
  shortlistedJobId String?
  shortlistedJob   JobRequirement? @relation(fields: [shortlistedJobId], references: [id])

  status             CandidateStatus @default(PENDING_WIZARD)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // 🏷️ Source tagging & ownership
  source        CandidateSource @default(USER_PORTAL)
  createdById   String?
  createdBy     Admin?    @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    Admin?    @relation("CandidateAssignedTo", fields: [assignedToId], references: [id])

  // Relational Arrays
  education          CandidateEducation[]
  technical          CandidateTechnical[]
  experience         CandidateExperience[]

  // 📋 Audit-trail relations
  communicationLogs CommunicationLog[]
  statusHistory     StatusHistory[]
  assignmentLogs     AssignmentLog[]

  @@index([assignedToId])
  @@index([status])
  @@index([source])
}

model CandidateEducation {
  id          String    @id @default(uuid())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  course      String
}

model CandidateTechnical {
  id          String    @id @default(uuid())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  course      String
}

model CandidateExperience {
  id          String    @id @default(uuid())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  fromYear    String
  toYear      String
}

// ==========================================
// 3. AUDIT-TRAIL MODELS
// ==========================================
model CommunicationLog {
  id          String    @id @default(uuid())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    String
  author      Admin     @relation(fields: [authorId], references: [id])
  note        String
  callbackAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

model StatusHistory {
  id          String           @id @default(uuid())
  candidateId Int
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStatus  CandidateStatus?
  toStatus    CandidateStatus
  changedById String
  changedBy   Admin            @relation(fields: [changedById], references: [id])
  changedAt   DateTime         @default(now())

  @@index([candidateId])
}

model AssignmentLog {
  id           String    @id @default(uuid())
  candidateId  Int
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   Admin     @relation("AssignmentLogAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   Admin     @relation("AssignmentLogAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())

  @@index([candidateId])
}

// ==========================================
// 4. EMPLOYER & REQUIREMENTS SCHEMA
// ==========================================
enum EmployerStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED   // For revoking access after activation, not just at signup
}

model Employer {
  id          String         @id @default(uuid())
  companyName String
  email       String         @unique
  phoneNumber String         @unique
  password    String         // Hashed secure string
  status      EmployerStatus @default(PENDING_VERIFICATION)
  createdAt   DateTime       @default(now())

  approvedById String?
  approvedBy   Admin?   @relation(fields: [approvedById], references: [id])
  approvedAt   DateTime?
  
  jobs        JobRequirement[]
}

model JobRequirement {
  id             String   @id @default(uuid())
  employerId     String
  employer       Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  roleTitle      String   // E.g., "Electrician"
  salaryRange    String
  location       String[] // One or more target districts
  maritalStatus  String   @default("No Preference")
  educationLevel String
  expRequired    Int      @default(0) // 0=Any, 1-10, 11=10+
  vacanciesCount Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  shortlistedCandidates Candidate[]
}
